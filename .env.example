# FraudEngine Environment Configuration
# Automatically generated on first run if missing

# Admin credentials (randomly generated if omitted)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password

# Analyst credentials
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=change_this_to_a_secure_analyst_password

# JWT secret key for console auth tokens
SECRET_KEY=change_this_jwt_secret_key_in_production

# Optional Public Gateway URL (e.g. https://your-tunnel.trycloudflare.com)
# When set, Live Sandbox QR codes automatically point to this public URL
PUBLIC_BASE_URL=
